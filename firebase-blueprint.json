          "maxLength": 160
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin", "kepala_pkbm", "guru", "murid"]
        },
        "status": {
          "type": "string",
          "enum": ["Aktif", "Nonaktif"]
        },
        "authVersion": {
          "type": "number"
        },
        "nis": {
          "type": "string",
          "maxLength": 32
        },
        "nip": {
          "type": "string",
          "maxLength": 32
        },
        "linkedEntityId": {
          "type": "string",
          "maxLength": 128
        },
        "classLabel": {
          "type": "string",
          "maxLength": 120
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 120000
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "internalEmail", "name", "role", "status", "authVersion", "createdAt", "updatedAt"]
